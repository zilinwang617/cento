{
  "name": "cento",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.5.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:extension": "node scripts/build-extension.mjs --watch",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:extension": "node --test tests/capture.test.mjs tests/extension.test.mjs tests/service-worker.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {}
}
